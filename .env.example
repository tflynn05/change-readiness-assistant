# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Models (defaults shown). Effort sets how much the model thinks: low | medium | high.
# Thinking counts toward the max-token limits, which leave room for it.
# CRA_MODEL=claude-sonnet-5-5
# CRA_EFFORT=medium
# CRA_MAX_TOKENS=8000
# CRA_JUDGE_MODEL=claude-opus-5-5
# CRA_JUDGE_EFFORT=medium
# CRA_JUDGE_MAX_TOKENS=16000

# Retrieval: bm25 (no extra install), embed, or hybrid (pip install -e ".[embed]")
# CRA_RETRIEVAL=bm25
# CRA_TOP_K=6
# CRA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Grounding gate thresholds (calibrated by `cra eval --retrieval-only`)
# CRA_MIN_BM25=0.14
# CRA_MIN_COSINE=0.55

# Private knowledge base: corpus/private/ is always read. To read another folder in
# place (nothing is copied), name it here. Relative paths start from this project
# folder; separate several folders with ":".
# CRA_PRIVATE_DIR=../Certifications/Prosci

# Guardrails
# CRA_MIN_CITATION_COVERAGE=0.6
# CRA_MAX_PRIVATE_QUOTE_WORDS=25
# Set to 0 to ignore corpus/private/ entirely
# CRA_INCLUDE_PRIVATE=1
